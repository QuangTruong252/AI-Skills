{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figma-variables.snapshot.schema.json",
  "title": "FigmaVariablesSnapshot",
  "type": "object",
  "required": ["schemaVersion", "documentName", "pluginVersion", "exportTime", "collections"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string" },
    "documentName": { "type": "string" },
    "pluginVersion": { "type": "string" },
    "exportTime": { "type": "string" },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "modes", "variables"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "modes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" }
              }
            }
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "originalName", "normalizedName", "collectionId", "resolvedType", "valuesByMode"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "originalName": { "type": "string" },
                "normalizedName": { "type": "string" },
                "collectionId": { "type": "string" },
                "resolvedType": {
                  "type": "string",
                  "enum": ["COLOR", "FLOAT", "STRING", "BOOLEAN", "UNSUPPORTED"]
                },
                "valuesByMode": { "type": "object" },
                "description": { "type": "string" },
                "scopes": { "type": "array", "items": { "type": "string" } },
                "codeSyntax": { "type": "object", "additionalProperties": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "diagnostics": { "type": "array" }
  }
}

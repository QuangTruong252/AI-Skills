{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figma-to-code.config.schema.json",
  "title": "FigmaToCodeConfig",
  "type": "object",
  "required": ["schemaVersion", "scss", "figma", "mapping", "output"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "projectRoot": { "type": "string" },
    "scss": {
      "type": "object",
      "required": ["tokenPaths", "tokenNamespaces", "privatePrefix"],
      "properties": {
        "tokenPaths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "includePrivate": { "type": "boolean" },
        "tokenNamespaces": { "type": "array", "items": { "type": "string" } },
        "privatePrefix": { "type": "string" },
        "layerHeuristics": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "figma": {
      "type": "object",
      "required": ["snapshotPath", "pluginVersion"],
      "properties": {
        "snapshotPath": { "type": "string" },
        "pluginVersion": { "type": "string" }
      }
    },
    "mapping": {
      "type": "object",
      "required": ["tokenMapPath"],
      "properties": {
        "tokenMapPath": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "required": ["registryPath", "adapterScssPath", "uiSpecPath"],
      "properties": {
        "registryPath": { "type": "string" },
        "adapterScssPath": { "type": "string" },
        "uiSpecPath": { "type": "string" },
        "systemRegistryDebugPath": { "type": "string" }
      }
    },
    "breakpoints": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "viewports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "width"],
            "properties": {
              "name": { "type": "string" },
              "width": { "type": "number" }
            }
          }
        }
      }
    },
    "valueDrift": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "normalizeColors": { "type": "boolean" }
      }
    },
    "freezeExportTime": { "type": "string" },
    "bootstrap": {
      "type": "object",
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["figmaCollection", "namePattern", "systemNameTemplate", "outputFile"],
            "properties": {
              "figmaCollection": { "type": "string" },
              "namePattern": { "type": "string" },
              "systemNameTemplate": { "type": "string" },
              "outputFile": { "type": "string" },
              "modeSelectorMap": { "type": "object", "additionalProperties": { "type": "string" } },
              "modeAtRuleMap": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}

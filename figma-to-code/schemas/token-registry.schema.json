{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "token-registry.schema.json",
  "title": "TokenRegistryGenerated",
  "type": "object",
  "required": [
    "schemaVersion",
    "figmaTokens",
    "systemTokens",
    "resolvedMappings",
    "suggestedMappings",
    "diagnostics"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string" },
    "figmaTokens": { "type": "object" },
    "systemTokens": { "type": "object" },
    "resolvedMappings": { "type": "object" },
    "suggestedMappings": { "type": "object" },
    "diagnostics": {
      "type": "object",
      "required": [
        "unmappedFigmaTokens",
        "missingSystemTokens",
        "typeMismatches",
        "modeMismatches",
        "valueDrifts",
        "circularAliases",
        "brokenReferences",
        "items"
      ],
      "properties": {
        "unmappedFigmaTokens": { "type": "array", "items": { "type": "string" } },
        "missingSystemTokens": { "type": "array", "items": { "type": "string" } },
        "typeMismatches": { "type": "array", "items": { "type": "string" } },
        "modeMismatches": { "type": "array", "items": { "type": "string" } },
        "valueDrifts": { "type": "array", "items": { "type": "string" } },
        "circularAliases": { "type": "array", "items": { "type": "string" } },
        "brokenReferences": { "type": "array", "items": { "type": "string" } },
        "items": { "type": "array" }
      }
    }
  }
}
